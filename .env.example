# Dispatcher365 local environment example
# Copy to .env or set values in your shell. Never commit real secrets.

PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_password_at_least_10_chars
ADMIN_NAME=Platform Owner

# Optional PostgreSQL. If omitted, local JSON fallback is used.
DATABASE_URL=
PGSSLMODE=disable

# Optional local upload folder.
UPLOADS_DIR=uploads

# Optional integrations.
GEOAPIFY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_BASE=
STRIPE_PRICE_STARTER_DRIVER=
STRIPE_PRICE_OPERATIONS_BASE=
STRIPE_PRICE_OPERATIONS_DRIVER=
STRIPE_PRICE_PRO_BASE=
STRIPE_PRICE_PRO_DRIVER=
STRIPE_TRIAL_DAYS=14

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
